{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashish-kumar-noon/stickybot/docs/faces/face.schema.json",
  "title": "StickyBot face package manifest, format 1",
  "description": "The manifest.json of a face package (docs/faces/FORMAT.md). The schema covers the shape; tools/faces/validate.py adds the checks a schema can't express (references, bindings, fonts, budgets, pictures).",
  "type": "object",
  "required": ["format", "id", "name", "version", "author", "license", "about", "minFirmware", "layouts"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "format": {"const": 1, "description": "The face format version (this document: 1)."},
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,11}$",
      "description": "3-12 characters, a-z then a-z / 0-9. Unique across the built-in faces and the catalog; never reused."
    },
    "name": {"type": "string", "minLength": 2, "maxLength": 24},
    "version": {"$ref": "#/$defs/semver"},
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 40},
        "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"},
        "url": {"type": "string", "pattern": "^https://", "maxLength": 120}
      }
    },
    "license": {
      "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause"],
      "description": "Covers the manifest and every image in the package."
    },
    "about": {"type": "string", "minLength": 4, "maxLength": 80},
    "tags": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,15}$"}
    },
    "minFirmware": {"$ref": "#/$defs/semver"},
    "motion": {
      "enum": ["static", "calm", "lively"],
      "description": "The frame-rate tier (FORMAT.md, Animation). Default static."
    },
    "colors": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,15}$"},
      "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
    },
    "images": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,15}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["src"],
        "additionalProperties": false,
        "properties": {
          "src": {"type": "string", "pattern": "^img/[a-z0-9][a-z0-9_-]{0,31}\\.png$"},
          "frameW": {"type": "integer", "minimum": 1, "maximum": 128}
        }
      }
    },
    "parts": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,15}$"},
      "additionalProperties": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/element"}}
    },
    "reactions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/event"},
      "additionalProperties": {"type": "integer", "minimum": 500, "maximum": 15000}
    },
    "layouts": {
      "type": "object",
      "required": ["portrait", "landscape"],
      "additionalProperties": false,
      "properties": {
        "portrait": {"$ref": "#/$defs/layout"},
        "landscape": {"$ref": "#/$defs/layout"}
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"},
    "event": {
      "enum": ["merged", "ci_red", "ci_green", "claude_start", "claude_done", "release", "level_up", "review",
               "shake", "flick", "upside_down", "lift", "minute", "hour", "dusk", "dawn", "urgent"]
    },
    "binding": {"type": "string", "pattern": "^[a-z]+\\.[a-zA-Z0-9_]+$"},
    "color": {"type": "string", "pattern": "^(#[0-9a-fA-F]{6}|[a-z][a-z0-9_]{0,15})$"},
    "coord": {"type": "integer", "minimum": -240, "maximum": 480},
    "num": {
      "description": "A number from a binding: var * mul + add, then clamped to lo..hi.",
      "type": "object",
      "required": ["var"],
      "additionalProperties": false,
      "properties": {
        "var": {"$ref": "#/$defs/binding"},
        "mul": {"type": "number", "minimum": -1000, "maximum": 1000},
        "add": {"type": "number", "minimum": -1000, "maximum": 1000},
        "lo": {"type": "number"},
        "hi": {"type": "number"}
      }
    },
    "pos": {"anyOf": [{"$ref": "#/$defs/coord"}, {"$ref": "#/$defs/num"}]},
    "frac": {
      "description": "A 0..1 fill: a constant, or var / of (clamped).",
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {
          "type": "object",
          "required": ["var", "of"],
          "additionalProperties": false,
          "properties": {"var": {"$ref": "#/$defs/binding"}, "of": {"type": "number", "minimum": 1, "maximum": 100000}}
        }
      ]
    },
    "anchor": {"enum": ["tl", "tc", "tr", "ml", "mc", "mr", "bl", "bc", "br"]},
    "font": {"enum": [10, 12, 14, 18, 24, 32, 44, 56, 96]},
    "cond": {
      "anyOf": [
        {"type": "string", "pattern": "^!?[a-z]+\\.[a-zA-Z0-9_]+$"},
        {
          "type": "object",
          "required": ["var"],
          "additionalProperties": false,
          "minProperties": 2,
          "maxProperties": 2,
          "properties": {
            "var": {"$ref": "#/$defs/binding"},
            "eq": {"type": ["number", "string", "boolean"]},
            "ne": {"type": ["number", "string", "boolean"]},
            "gt": {"type": "number"},
            "ge": {"type": "number"},
            "lt": {"type": "number"},
            "le": {"type": "number"}
          }
        },
        {"type": "object", "required": ["all"], "additionalProperties": false,
         "properties": {"all": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/cond"}}}},
        {"type": "object", "required": ["any"], "additionalProperties": false,
         "properties": {"any": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/cond"}}}},
        {"type": "object", "required": ["not"], "additionalProperties": false,
         "properties": {"not": {"$ref": "#/$defs/cond"}}}
      ]
    },
    "tween": {
      "type": "object",
      "required": ["prop", "to", "ms"],
      "additionalProperties": false,
      "properties": {
        "prop": {"enum": ["x", "y", "mix", "color", "frame"]},
        "from": {"type": ["number", "string"]},
        "to": {"type": ["number", "string"]},
        "ms": {"type": "integer", "minimum": 50, "maximum": 120000},
        "ease": {"enum": ["linear", "in", "out", "inout", "sine", "back"]},
        "loop": {"enum": ["once", "repeat", "pingpong"]},
        "delay": {"type": "integer", "minimum": 0, "maximum": 60000},
        "phase": {"type": "integer", "minimum": 0, "maximum": 60000},
        "on": {"$ref": "#/$defs/event"},
        "times": {"type": "integer", "minimum": 1, "maximum": 20},
        "mixTo": {"$ref": "#/$defs/color"}
      }
    },
    "repeat": {
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": {
        "count": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 16}, {"$ref": "#/$defs/binding"}]},
        "max": {"type": "integer", "minimum": 1, "maximum": 16},
        "dx": {"type": "integer", "minimum": -240, "maximum": 240},
        "dy": {"type": "integer", "minimum": -240, "maximum": 240}
      }
    },
    "common": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "name": {"type": "string", "maxLength": 24},
        "x": {"$ref": "#/$defs/pos"},
        "y": {"$ref": "#/$defs/pos"},
        "when": {"$ref": "#/$defs/cond"},
        "anim": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/tween"}},
        "repeat": {"$ref": "#/$defs/repeat"},
        "mix": {"type": "number", "minimum": 0, "maximum": 1,
                "description": "Blend the element's colours this far toward mixTo (default: the layout's background)."},
        "mixTo": {"$ref": "#/$defs/color"}
      }
    },
    "element": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {"$ref": "#/$defs/rect"}, {"$ref": "#/$defs/line"}, {"$ref": "#/$defs/circle"}, {"$ref": "#/$defs/arc"},
        {"$ref": "#/$defs/bar"}, {"$ref": "#/$defs/text"}, {"$ref": "#/$defs/image"}, {"$ref": "#/$defs/hand"},
        {"$ref": "#/$defs/ticks"}, {"$ref": "#/$defs/weather"}, {"$ref": "#/$defs/scatter"}, {"$ref": "#/$defs/group"}
      ]
    },
    "rect": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "w", "h"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "rect"},
        "anchor": {"$ref": "#/$defs/anchor"},
        "w": {"type": "integer", "minimum": 1, "maximum": 240},
        "h": {"type": "integer", "minimum": 1, "maximum": 240},
        "r": {"type": "integer", "minimum": 0, "maximum": 60},
        "fill": {"$ref": "#/$defs/color"},
        "stroke": {"$ref": "#/$defs/color"}
      }
    },
    "line": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "x2", "y2", "color"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "line"},
        "x2": {"$ref": "#/$defs/coord"},
        "y2": {"$ref": "#/$defs/coord"},
        "width": {"type": "number", "minimum": 0.5, "maximum": 8},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "circle": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "r"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "circle"},
        "r": {"type": "integer", "minimum": 1, "maximum": 120},
        "fill": {"$ref": "#/$defs/color"},
        "stroke": {"$ref": "#/$defs/color"}
      }
    },
    "arc": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "r", "t", "color"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "arc"},
        "r": {"type": "integer", "minimum": 2, "maximum": 120},
        "t": {"type": "integer", "minimum": 1, "maximum": 60},
        "start": {"type": "integer", "minimum": -360, "maximum": 360},
        "end": {"type": "integer", "minimum": -360, "maximum": 720},
        "value": {"$ref": "#/$defs/frac"},
        "color": {"$ref": "#/$defs/color"},
        "track": {"$ref": "#/$defs/color"}
      }
    },
    "bar": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "w", "h", "value", "color"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "bar"},
        "anchor": {"$ref": "#/$defs/anchor"},
        "w": {"type": "integer", "minimum": 2, "maximum": 240},
        "h": {"type": "integer", "minimum": 1, "maximum": 240},
        "r": {"type": "integer", "minimum": 0, "maximum": 30},
        "dir": {"enum": ["right", "up"]},
        "value": {"$ref": "#/$defs/frac"},
        "color": {"$ref": "#/$defs/color"},
        "track": {"$ref": "#/$defs/color"}
      }
    },
    "text": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "text", "color"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "text"},
        "anchor": {"$ref": "#/$defs/anchor"},
        "text": {"type": "string", "minLength": 1, "maxLength": 64},
        "font": {"$ref": "#/$defs/font"},
        "fit": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/font"}},
        "w": {"type": "integer", "minimum": 8, "maximum": 240},
        "lines": {"type": "integer", "minimum": 1, "maximum": 3},
        "case": {"enum": ["upper", "lower"]},
        "color": {"$ref": "#/$defs/color"},
        "outline": {"$ref": "#/$defs/color"},
        "shadow": {"$ref": "#/$defs/color"}
      }
    },
    "image": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "image"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "image"},
        "anchor": {"$ref": "#/$defs/anchor"},
        "image": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$"},
        "frame": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 31}, {"$ref": "#/$defs/num"}]},
        "play": {
          "type": "object",
          "required": ["fps"],
          "additionalProperties": false,
          "properties": {
            "fps": {"type": "number", "minimum": 0.2, "maximum": 12},
            "seq": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 31}}
          }
        },
        "scale": {"type": "integer", "minimum": 1, "maximum": 4},
        "tile": {"enum": ["x"]},
        "flip": {"enum": ["x"]}
      }
    },
    "hand": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "hand", "length", "color"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "hand"},
        "hand": {"enum": ["hour", "minute", "second"]},
        "length": {"type": "integer", "minimum": 2, "maximum": 120},
        "tail": {"type": "integer", "minimum": 0, "maximum": 60},
        "w0": {"type": "number", "minimum": 0.5, "maximum": 8},
        "w1": {"type": "number", "minimum": 0.5, "maximum": 8},
        "color": {"$ref": "#/$defs/color"},
        "shadow": {"$ref": "#/$defs/color"}
      }
    },
    "ticks": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "r", "count", "color"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "ticks"},
        "r": {"type": "integer", "minimum": 4, "maximum": 120},
        "count": {"type": "integer", "minimum": 2, "maximum": 120},
        "len": {"type": "integer", "minimum": 1, "maximum": 40},
        "width": {"type": "number", "minimum": 0.5, "maximum": 6},
        "color": {"$ref": "#/$defs/color"},
        "every": {"type": "integer", "minimum": 1, "maximum": 60},
        "majorLen": {"type": "integer", "minimum": 1, "maximum": 40},
        "majorWidth": {"type": "number", "minimum": 0.5, "maximum": 6},
        "majorColor": {"$ref": "#/$defs/color"},
        "firstColor": {"$ref": "#/$defs/color"}
      }
    },
    "weather": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "weather"},
        "anchor": {"$ref": "#/$defs/anchor"},
        "size": {"type": "integer", "minimum": 12, "maximum": 48}
      }
    },
    "scatter": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type", "w", "h", "n", "color"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "scatter"},
        "w": {"type": "integer", "minimum": 1, "maximum": 240},
        "h": {"type": "integer", "minimum": 1, "maximum": 240},
        "n": {"type": "integer", "minimum": 1, "maximum": 48},
        "seed": {"type": "integer", "minimum": 0, "maximum": 65535},
        "size": {"type": "integer", "minimum": 1, "maximum": 3},
        "color": {"$ref": "#/$defs/color"},
        "twinkle": {"type": "integer", "minimum": 0, "maximum": 20000},
        "fall": {"type": "integer", "minimum": -120, "maximum": 120},
        "drift": {"type": "integer", "minimum": -120, "maximum": 120}
      }
    },
    "group": {
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["type"],
      "unevaluatedProperties": false,
      "properties": {
        "type": {"const": "group"},
        "part": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$"},
        "children": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/element"}}
      }
    },
    "layout": {
      "type": "object",
      "required": ["elements"],
      "additionalProperties": false,
      "properties": {
        "bg": {
          "anyOf": [
            {"$ref": "#/$defs/color"},
            {"type": "object", "required": ["grad"], "additionalProperties": false,
             "properties": {"grad": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/color"}},
                            "dir": {"enum": ["v", "h"]}}}
          ]
        },
        "status": {"enum": ["light", "dark", "pill"]},
        "card": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"type": "integer", "minimum": 0, "maximum": 240}
        },
        "elements": {"type": "array", "minItems": 1, "maxItems": 48, "items": {"$ref": "#/$defs/element"}}
      }
    }
  }
}
