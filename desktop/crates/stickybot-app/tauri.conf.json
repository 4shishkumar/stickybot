{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickyBot",
  "identifier": "com.stickybot.rs",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
