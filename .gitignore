# PlatformIO build cache and downloaded libraries (recreated on first build)
.pio/

# Factory flash backups — specific to one device, made with tools/backup.sh
backup/

# Generated at build time from web/settings.html
**/src/web_page.h

.DS_Store

# Firmware builds are release assets, not committed: the agent downloads them into
# ~/.stick-agent/firmware/<version>/; `make -C m5-stick-s3 release` writes a local
# build to ~/.stick-agent/firmware/local/. (Older bundles lived in the package.)
mac-agent/stick_agent/firmware/
/dist/

# Local secrets (OTA password)
**/secrets.ini
**/tools/sounds/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Claude Code agent worktrees
.claude/worktrees/

# fab-kit: per-checkout state and locks (the pinned version is committed). The skills in
# .claude/skills/ and .agents/skills/ are ignored by the .gitignore `fab sync` writes there.
.fab-*
!fab/.fab-version
.status.yaml.lock
/.claude/settings.local.json
